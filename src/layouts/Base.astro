---
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/public-sans';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const { title, description = 'LawOn.id, platform layanan hukum: edukasi, konsultasi, dan informasi hukum dalam satu wadah.' } = Astro.props;
const fullTitle = title ? `${title} | LawOn.id` : 'LawOn.id | Edukasi, Konsultasi, dan Informasi Hukum';
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Versi demo. Hapus noindex saat website live. -->
    <meta name="robots" content="noindex, nofollow" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#isi">Langsung ke isi</a>
    <Header />
    <main id="isi"><slot /></main>
    <Footer />
  </body>
</html>
