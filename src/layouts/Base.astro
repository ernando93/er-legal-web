---
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/public-sans';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WaFloat from '../components/WaFloat.astro';
import { site } from '../data/site';
import { judul } from '../lib/judul';

const { title, description = 'LawOn.id, platform layanan hukum: edukasi, konsultasi, dan informasi hukum dalam satu wadah.' } = Astro.props;
const fullTitle = title ? `${judul(title)} | LawOn.id` : 'LawOn.id | Edukasi, Konsultasi, dan Informasi Hukum';

// Alamat lengkap untuk preview link (WhatsApp, LinkedIn, dan lain-lain).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`${base}/og.png`, Astro.site).href;

// Data terstruktur untuk mesin pencari (berlaku setelah noindex dihapus).
const homeUrl = new URL(`${base}/`, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  legalName: site.entity,
  url: homeUrl,
  logo: new URL(`${base}/logo-lawon.svg`, Astro.site).href,
  slogan: site.tagline,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Next Office, Menara Agrinas Palma Lantai 15 Unit 15-03, Jl. H.R. Rasuna Said Kav. VI No. 9 Blok X2',
    addressLocality: 'Jakarta Selatan',
    addressRegion: 'DKI Jakarta',
    postalCode: '12950',
    addressCountry: 'ID',
  },
};
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Versi demo. Hapus noindex saat website live. -->
    <meta name="robots" content="noindex, nofollow" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#13306b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content="LawOn.id" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="LawOn.id: edukasi, konsultasi, dan informasi hukum dalam satu wadah" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Animasi muncul saat scroll. Tanpa JavaScript, semua konten tetap tampil. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        d.classList.add('reveal-on');
        document.addEventListener('DOMContentLoaded', function () {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
            });
          }, { rootMargin: '0px 0px -8% 0px' });
          document.querySelectorAll('[data-reveal]').forEach(function (el) { io.observe(el); });
        });
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#isi">Langsung ke isi</a>
    <Header />
    <main id="isi"><slot /></main>
    <Footer />
    <WaFloat />
  </body>
</html>
