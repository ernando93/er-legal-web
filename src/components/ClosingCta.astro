---
import { site } from '../data/site';
const { judul = 'Punya pertanyaan hukum, atau ingin belajar hukum? Mulai dari satu pesan.' } = Astro.props;
---
<section class="closing">
  <div class="wrap closing-in">
    <h2>{judul}</h2>
    <div class="closing-act">
      <a class="btn" href="/kontak">Hubungi kami</a>
      <a class="tlink" href={site.whatsappHref}>Atau chat WhatsApp</a>
    </div>
  </div>
</section>
