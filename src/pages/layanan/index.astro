---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import { layanan } from '../../data/layanan';
---
<Base title="Layanan" description="Edukasi hukum, konsultasi hukum, dan informasi hukum dari LawOn.id.">
  <div class="page-head">
    <div class="wrap page-head-in">
      <h1>Layanan</h1>
      <p class="lede">Edukasi, konsultasi, dan informasi hukum. Pilih yang paling dekat dengan kebutuhan Anda.</p>
    </div>
  </div>
  <section class="wrap svc-table">
    <ol class="index">
      {layanan.map((l) => (
        <li>
          <a href={`/layanan/${l.slug}`}>
            <h2 class="index-title">{l.title}</h2>
            <p>{l.short}<span class="index-meta">{l.untuk}</span></p>
            <Icon name="arrow-right" size={22} />
          </a>
        </li>
      ))}
    </ol>
  </section>
  <ClosingCta judul="Belum yakin layanan mana yang Anda butuhkan? Tanyakan saja." />
</Base>
