---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { site } from '../data/site';
import ruang from '../assets/photos/ruang-rapat.jpg';
import jakarta from '../assets/photos/jakarta.jpg';

const pasal = [
  ['Biaya disepakati sebelum mulai', 'Anda menerima rincian tertulis. Bila ruang lingkup berubah, kami bicarakan dulu sebelum menagih.'],
  ['Satu orang yang bertanggung jawab', 'Setiap perkara punya satu advokat sebagai kontak utama, yang tahu perkembangan terakhirnya.'],
  ['Bahasa yang bisa dimengerti', 'Istilah hukum kami jelaskan. Memo kami selalu dimulai dengan ringkasan satu halaman.'],
  ['Kerahasiaan adalah kewajiban', 'Apa yang Anda sampaikan kepada kami dijaga kerahasiaannya, sesuai kewajiban profesi advokat.'],
];
---
<Base title="Tentang Kami" description="Profil dan cara kerja Kantor Advokat ER Legal.">
  <div class="page-head">
    <div class="wrap page-head-in">
      <h1>Kantor kecil, dengan kebiasaan menjelaskan.</h1>
      <p class="lede">ER Legal didirikan untuk satu alasan: klien berhak mengerti urusan hukumnya sendiri.</p>
    </div>
  </div>

  <div class="wide-photo">
    <Image src={ruang} alt="Ruang rapat kantor dengan dinding kaca" widths={[800, 1400, 1800]} sizes="100vw" loading="eager" />
  </div>

  <section class="wrap split story">
    <div class="split-head"><h2>Cerita kami</h2></div>
    <div class="story-body">
      <p class="lede">Elvira Rahadian mendirikan kantor ini setelah terlalu sering melihat klien keluar dari rapat dengan memo tebal dan tanpa kejelasan apa yang harus dilakukan besok pagi.</p>
      <p>Kami sengaja tetap ramping. Advokat yang Anda temui di pertemuan pertama adalah advokat yang mengerjakan perkara Anda. Klien kami kebanyakan pemilik usaha, perusahaan keluarga, dan perorangan yang menghadapi keputusan penting.</p>
      <p>Bila kami merasa suatu perkara lebih baik ditangani pihak lain, atau lebih baik tidak diteruskan, kami akan mengatakannya.</p>
    </div>
  </section>

  <section class="pasal">
    <div class="wrap">
      <h2>Empat pasal yang kami pegang</h2>
      <ol class="pasal-list">
        {pasal.map(([judul, isi], i) => (
          <li>
            <span class="pasal-num">Pasal {i + 1}</span>
            <h3>{judul}</h3>
            <p>{isi}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="wrap split legal-table">
    <div class="split-head">
      <h2>Data kantor</h2>
      <p>Seluruh data di bagian ini masih contoh untuk demo.</p>
    </div>
    <div>
      <dl class="dl">
        <div><dt>Nama</dt><dd>{site.entity}</dd></div>
        <div><dt>Bentuk</dt><dd>Persekutuan perdata</dd></div>
        <div><dt>Organisasi advokat</dt><dd>Diisi sesuai keanggotaan</dd></div>
        <div><dt>Alamat</dt><dd>{site.address.join(', ')}</dd></div>
      </dl>
    </div>
  </section>

  <div class="wide-photo">
    <Image src={jakarta} alt="Bundaran Hotel Indonesia di Jakarta dengan gedung tinggi di belakangnya" widths={[800, 1400, 1800]} sizes="100vw" />
  </div>

  <ClosingCta judul="Ingin tahu apakah kami cocok untuk urusan Anda?" />
</Base>
