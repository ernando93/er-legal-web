---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import { tanggal } from '../../data/site';
import buku from '../../assets/photos/buku.jpg';
import perpustakaan from '../../assets/photos/perpustakaan.jpg';
import dokumen from '../../assets/photos/dokumen.jpg';

export async function getStaticPaths() {
  const all = await getCollection('artikel');
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const foto = { Kontrak: buku, Sengketa: perpustakaan, Ketenagakerjaan: dokumen }[entry.data.category as string] ?? buku;
---
<Base title={entry.data.title} description={entry.data.excerpt}>
  <header class="wrap article-head">
    <div class="article-head-in">
      <p class="crumb"><a href="/artikel">Artikel</a></p>
      <h1>{entry.data.title}</h1>
      <p class="muted" style="margin-top:1.25rem">{entry.data.author}, {tanggal(entry.data.date)}</p>
    </div>
  </header>
  <div class="article-photo">
    <Image src={foto} alt="" widths={[800, 1400, 1800]} sizes="100vw" loading="eager" />
  </div>
  <article class="wrap">
    <div class="prose-wrap">
      <div class="prose"><Content /></div>
      <p class="demo-note">Artikel contoh untuk demo dan belum ditinjau advokat. Tulisan ini informasi umum, bukan nasihat hukum untuk kasus tertentu.</p>
    </div>
  </article>
  <ClosingCta judul="Punya pertanyaan untuk kasus Anda sendiri?" />
</Base>
