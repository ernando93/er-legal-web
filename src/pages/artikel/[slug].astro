---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import { tanggal } from '../../data/site';
import buku from '../../assets/photos/buku.jpg';
import perpustakaan from '../../assets/photos/perpustakaan.jpg';
import dokumen from '../../assets/photos/dokumen.jpg';

export async function getStaticPaths() {
  const all = (await getCollection('artikel')).sort((a, b) => +b.data.date - +a.data.date);
  return all.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, lain: all.filter((x) => x.id !== entry.id).slice(0, 2) },
  }));
}
const { entry, lain } = Astro.props;
const { Content } = await render(entry);
const foto = { Kontrak: buku, Sengketa: perpustakaan, Ketenagakerjaan: dokumen }[entry.data.category as string] ?? buku;

// Perkiraan waktu baca: sekitar 200 kata per menit.
const kata = (entry.body ?? '').split(/\s+/).filter(Boolean).length;
const menit = Math.max(1, Math.round(kata / 200));

const url = new URL(Astro.url.pathname, Astro.site).href;
const shareWa = `https://wa.me/?text=${encodeURIComponent(`${entry.data.title} ${url}`)}`;
const shareLi = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`;
---
<Base title={entry.data.title} description={entry.data.excerpt}>
  <div class="read-progress" aria-hidden="true"><span id="read-bar"></span></div>
  <header class="wrap article-head">
    <div class="article-head-in">
      <p class="crumb"><a href="/artikel">Publikasi</a> <span class="crumb-sep">/</span> {entry.data.category}</p>
      <h1>{entry.data.title}</h1>
      <p class="article-meta">
        <span>{entry.data.author}</span>
        <span>{tanggal(entry.data.date)}</span>
        <span>{menit} menit baca</span>
      </p>
    </div>
  </header>
  <div class="article-photo">
    <Image src={foto} alt="" widths={[800, 1400, 1800]} sizes="100vw" loading="eager" />
  </div>
  <article class="wrap">
    <div class="prose-wrap">
      <div class="prose"><Content /></div>
      <div class="share">
        <span class="share-lab">Bagikan</span>
        <a href={shareWa} target="_blank" rel="noopener">WhatsApp</a>
        <a href={shareLi} target="_blank" rel="noopener">LinkedIn</a>
        <button type="button" id="salin" data-url={url}>Salin tautan</button>
      </div>
      <p class="demo-note">Artikel contoh untuk demo dan belum ditinjau. Tulisan ini informasi umum, bukan nasihat hukum untuk kasus tertentu.</p>
    </div>
  </article>

  {lain.length > 0 && (
    <section class="more" data-reveal>
      <div class="wrap">
        <div class="alur-head">
          <h2>Publikasi lainnya</h2>
          <a class="tlink" href="/artikel">Semua publikasi</a>
        </div>
        <ul class="more-list">
          {lain.map((a) => (
            <li>
              <a href={`/artikel/${a.id}`}>
                <p class="a-meta">{a.data.category}, {tanggal(a.data.date)}</p>
                <h3>{a.data.title}</h3>
                <p class="muted">{a.data.excerpt}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <ClosingCta judul="Punya pertanyaan untuk persoalan Anda sendiri?" />
</Base>

<script>
  // Garis progres baca di bawah header.
  const bar = document.getElementById('read-bar');
  const prose = document.querySelector('.prose');
  const update = () => {
    if (!bar || !prose) return;
    const r = prose.getBoundingClientRect();
    const total = r.height - window.innerHeight * 0.6;
    const p = Math.min(1, Math.max(0, -r.top / Math.max(total, 1)));
    bar.style.transform = `scaleX(${p})`;
  };
  update();
  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update);

  // Salin tautan artikel.
  const btn = document.getElementById('salin') as HTMLButtonElement | null;
  btn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(btn.dataset.url ?? location.href);
      btn.textContent = 'Tautan tersalin';
    } catch {
      btn.textContent = 'Gagal menyalin';
    }
    setTimeout(() => (btn.textContent = 'Salin tautan'), 2200);
  });
</script>
