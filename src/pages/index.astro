---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Portrait from '../components/Portrait.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { site, tanggal } from '../data/site';
import { layanan } from '../data/layanan';
import { tim } from '../data/tim';
import rapat from '../assets/photos/rapat.jpg';
import tandaTangan from '../assets/photos/tanda-tangan.jpg';
import buku from '../assets/photos/buku.jpg';

const artikel = (await getCollection('artikel')).sort((a, b) => +b.data.date - +a.data.date);
const [utama, ...lain] = artikel;
const [pendiri, ...anggota] = tim;
---
<Base>
  <div class="wrap hero">
    <div class="hero-copy">
      <p class="eyebrow">{site.tagline}</p>
      <h1>Edukasi, konsultasi, dan informasi hukum dalam satu wadah.</h1>
      <p class="lede">LawOn.id adalah platform layanan hukum yang dikelola {site.entity}. Kami menghadirkan layanan hukum yang profesional, aplikatif, dan mudah diakses oleh masyarakat, profesional, maupun pelaku usaha.</p>
      <div class="hero-act">
        <a class="btn" href="/kontak">Konsultasi hukum</a>
        <a class="tlink" href="/layanan">Lihat semua layanan</a>
      </div>
    </div>
    <figure class="hero-photo">
      <Image src={rapat} alt="Beberapa orang berdiskusi sambil mencatat di meja kayu" widths={[480, 800, 1200]} sizes="(max-width: 880px) 100vw, 42vw" loading="eager" fetchpriority="high" />
    </figure>
  </div>
  <div class="facts">
    <div class="wrap">
      <ul>
        <li><Icon name="map-pin" />Kuningan, Jakarta Selatan</li>
        <li><Icon name="whatsapp-logo" /><a href={site.whatsappHref}>Konsultasi lewat WhatsApp</a></li>
      </ul>
    </div>
  </div>

  <section class="wrap split s-services">
    <div class="split-head">
      <h2>Tiga layanan, satu tempat</h2>
      <p>Belajar hukum, menyelesaikan persoalan hukum, atau mengikuti perkembangan regulasi. Mulai dari yang paling Anda butuhkan.</p>
      <a class="tlink" href="/layanan">Lihat semua layanan</a>
    </div>
    <ol class="index">
      {layanan.map((l) => (
        <li>
          <a href={`/layanan/${l.slug}`}>
            <h3>{l.title}</h3>
            <p>{l.short}<span class="index-meta">{l.untuk}</span></p>
            <Icon name="arrow-right" size={22} />
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="process">
    <div class="wrap">
      <h2>Hukum bukan sekadar kumpulan aturan, melainkan bidang keilmuan yang perlu dikuasai dan diterapkan dengan tepat.</h2>
      <ol class="steps">
        <li>
          <span class="when">Pengetahuan</span>
          <h3>Butuh proses untuk dipahami</h3>
          <p>Lewat edukasi hukum, kami menyediakan ruang belajar untuk meningkatkan pengetahuan dan mengembangkan kompetensi.</p>
        </li>
        <li>
          <span class="when">Persoalan</span>
          <h3>Butuh ketelitian untuk dianalisis</h3>
          <p>Lewat konsultasi hukum, kami menjawab kebutuhan dan permasalahan hukum secara responsif dan solutif.</p>
        </li>
        <li>
          <span class="when">Solusi</span>
          <h3>Butuh pendekatan yang tepat</h3>
          <p>Lewat informasi hukum, kami membuka akses ke perkembangan regulasi, literatur, dan wawasan hukum yang relevan.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="stance">
    <Image src={tandaTangan} alt="Tangan menandatangani dokumen dengan pena" widths={[600, 1000, 1400]} sizes="(max-width: 880px) 100vw, 50vw" />
    <div class="stance-copy">
      <p class="eyebrow">Visi</p>
      <blockquote>Menjadi platform layanan hukum yang profesional, inovatif, dan terpercaya.</blockquote>
      <p>Dalam memperluas akses pengetahuan, informasi, serta solusi hukum, dengan mengedepankan pengetahuan, kompetensi, profesionalisme, dan kebermanfaatan.</p>
      <a class="tlink" href="/tentang">Visi dan misi kami</a>
    </div>
  </section>

  <section class="wrap s-team">
    <div class="team-head">
      <h2>Orang di balik LawOn.id</h2>
      <a class="tlink" href="/tim">Seluruh tim</a>
    </div>
    <div class="team-feature">
      <a href={`/tim/${pendiri.slug}`}><Portrait inisial={pendiri.inisial} warna={pendiri.warna} /></a>
      <div>
        <a href={`/tim/${pendiri.slug}`}><h3>{pendiri.nama}, {pendiri.gelar}</h3></a>
        <p class="team-role">{pendiri.jabatan}</p>
        <p class="lede">{pendiri.ringkas}</p>
        <ul class="team-list">
          {anggota.map((a) => (
            <li><a href={`/tim/${a.slug}`}><strong>{a.nama}</strong><span>{a.jabatan}</span></a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="s-articles">
    <div class="wrap">
      <h2>Publikasi hukum</h2>
      <div class="articles-grid">
        <a class="a-feature" href={`/artikel/${utama.id}`}>
          <Image src={buku} alt="Tumpukan buku dan pena di atas meja" widths={[600, 1000]} sizes="(max-width: 880px) 100vw, 55vw" />
          <p class="a-meta">{utama.data.category}, {tanggal(utama.data.date)}</p>
          <h3>{utama.data.title}</h3>
          <p class="muted">{utama.data.excerpt}</p>
        </a>
        <ul class="a-row">
          {lain.map((a) => (
            <li>
              <a href={`/artikel/${a.id}`}>
                <p class="a-meta">{a.data.category}, {tanggal(a.data.date)}</p>
                <h3>{a.data.title}</h3>
              </a>
            </li>
          ))}
          <li><a class="tlink" href="/artikel">Semua publikasi</a></li>
        </ul>
      </div>
    </div>
  </section>

  <ClosingCta />
</Base>
