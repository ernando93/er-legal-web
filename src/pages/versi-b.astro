---
import '@fontsource-variable/archivo/wdth.css';
import '../styles/versi-b.css';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Icon from '../components/Icon.astro';
import { site, tanggal } from '../data/site';
import { tim } from '../data/tim';
import jakarta from '../assets/photos/jakarta.jpg';

const link = (slug: string) => `/layanan/${slug}`;
const perusahaan = [
  ['korporasi-perizinan', 'Korporasi dan Perizinan'],
  ['kontrak-bisnis', 'Kontrak Bisnis'],
  ['ketenagakerjaan', 'Ketenagakerjaan'],
  ['sengketa-perdata', 'Sengketa dan Litigasi Perdata'],
];
const perorangan = [
  ['keluarga-waris', 'Keluarga dan Waris'],
  ['pertanahan-properti', 'Pertanahan dan Properti'],
  ['ketenagakerjaan', 'Masalah di tempat kerja'],
];
const pemeriksaan = [
  ['Struktur perusahaan', 'Akta, anggaran dasar, susunan pemegang saham dan direksi.'],
  ['Perizinan', 'NIB, KBLI, izin sektoral, dan ketentuan penanaman modal bila relevan.'],
  ['Kontrak material', 'Perubahan pengendalian, pembatasan pengalihan, dan kewajiban besar.'],
  ['Ketenagakerjaan', 'Status kontrak, peraturan perusahaan, dan potensi perselisihan.'],
  ['Aset', 'Hak atas tanah, jaminan, dan kekayaan intelektual.'],
  ['Sengketa', 'Perkara yang berjalan, somasi, dan potensi klaim.'],
];
const tahap = [
  ['Lingkup', 'Kita sepakati apa yang diperiksa, tenggat, dan biayanya secara tertulis.'],
  ['Pemeriksaan', 'Dokumen ditinjau oleh tim yang akan bertanggung jawab atas hasilnya.'],
  ['Temuan', 'Anda menerima risiko yang diurutkan berdasarkan dampaknya, dengan ringkasan untuk direksi.'],
  ['Pendampingan', 'Kami bantu menerjemahkan temuan ke dalam klausul dan negosiasi.'],
];
const artikel = (await getCollection('artikel')).sort((a, b) => +b.data.date - +a.data.date);
const menu = [
  ['#layanan', 'Layanan'],
  ['#investasi', 'Investasi'],
  ['#tim', 'Tim'],
  ['#artikel', 'Artikel'],
];
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>ER Legal | Hukum untuk Perusahaan dan Investor</title>
    <meta name="description" content="ER Legal mendampingi perusahaan dan investor di Indonesia." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="vb">
    <a class="skip" href="#isi">Langsung ke isi</a>
    <header class="top">
      <div class="in top-in">
        <a class="brand" href="/versi-b" aria-label="ER Legal, ke beranda"><b>ER</b><span>Legal</span></a>
        <nav class="top-nav" aria-label="Navigasi utama">
          {menu.map(([h, l]) => <a href={h}>{l}</a>)}
          <a class="top-cta" href="/kontak">Hubungi kami</a>
        </nav>
        <details class="m-menu">
          <summary aria-label="Menu"><Icon name="list" size={26} /></summary>
          <nav aria-label="Navigasi seluler">
            {menu.map(([h, l]) => <a href={h}>{l}</a>)}
            <a href="/kontak">Hubungi kami</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="isi">
      <section class="hero">
        <Image class="hero-img" src={jakarta} alt="Kawasan Bundaran Hotel Indonesia di pusat bisnis Jakarta" widths={[800, 1400, 1800]} sizes="100vw" loading="eager" fetchpriority="high" />
        <div class="in hero-in">
          <h1>Keputusan bisnis yang besar butuh pembacaan hukum yang jernih.</h1>
          <div class="hero-side">
            <p>ER Legal mendampingi perusahaan dan investor di Indonesia dalam korporasi, kontrak, perizinan, dan sengketa. Kami juga menerima klien perorangan.</p>
            <div class="acts">
              <a class="btn" href="/kontak">Diskusikan kebutuhan Anda</a>
              <a class="ln ln--d" href="#investasi">Pemeriksaan untuk investasi</a>
            </div>
          </div>
        </div>
      </section>

      <section class="paths in" id="layanan" aria-label="Pilih kebutuhan Anda">
        <div class="path path--main">
          <h2>Untuk perusahaan dan investor</h2>
          <ul>
            {perusahaan.map(([s, t]) => <li><a href={link(s)}>{t}<Icon name="arrow-right" size={22} /></a></li>)}
          </ul>
        </div>
        <div class="path path--side">
          <h2>Untuk perorangan</h2>
          <ul>
            {perorangan.map(([s, t]) => <li><a href={link(s)}>{t}<Icon name="arrow-right" size={20} /></a></li>)}
          </ul>
          <a class="ln" href={site.whatsappHref}>Tanya lewat WhatsApp</a>
        </div>
      </section>

      <section class="invest in" id="investasi">
        <div class="invest-head">
          <h2>Sebelum investasi ditandatangani</h2>
          <p>Pemeriksaan hukum yang menjawab satu pertanyaan: apa yang bisa mengubah harga, struktur, atau keputusan Anda.</p>
        </div>
        <dl class="grid-table">
          {pemeriksaan.map(([a, b]) => <div><dt>{a}</dt><dd>{b}</dd></div>)}
        </dl>
      </section>

      <section class="phases">
        <div class="in">
          <h2>Empat tahap, satu penanggung jawab</h2>
          <ol>
            {tahap.map(([a, b]) => <li><h3>{a}</h3><p>{b}</p></li>)}
          </ol>
        </div>
      </section>

      <section class="say">
        <div class="in">
          <p>Kami tidak menjanjikan hasil. Kami memberi Anda gambaran risiko yang jujur, sebelum Anda memutuskan.</p>
        </div>
      </section>

      <section class="team in" id="tim">
        <h2>Tim</h2>
        <ul>
          {tim.map((a) => (
            <li>
              <a href={`/tim/${a.slug}`}>
                <strong>{a.nama}</strong>
                <span>{a.jabatan}</span>
                <span class="f">{a.fokus.join(', ')}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="reads" id="artikel">
        <div class="in reads-in">
          <h2>Catatan hukum</h2>
          <ul>
            {artikel.map((a) => (
              <li>
                <a href={`/artikel/${a.id}`}>
                  <span>{a.data.category}, {tanggal(a.data.date)}</span>
                  <h3>{a.data.title}</h3>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="end">
        <div class="in end-in">
          <h2>Ada transaksi atau persoalan yang perlu dibaca?</h2>
          <a class="btn" href="/kontak">Hubungi kami</a>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="in foot-in">
        <div>
          <a class="brand" href="/versi-b" aria-label="ER Legal"><b>ER</b><span>Legal</span></a>
          <p>{site.entity}</p>
        </div>
        <address>{site.address.map((a) => <span>{a}</span>)}</address>
        <p><a href={site.phoneHref}>{site.phoneDisplay}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      <div class="in foot-legal">
        <p>Informasi di website ini bersifat umum dan bukan nasihat hukum.</p>
        <p><a href="/disclaimer">Disclaimer</a> · <a href="/kebijakan-privasi">Kebijakan Privasi</a></p>
        <p class="demo">Versi demo. Nama, alamat, nomor kontak, dan profil tim masih contoh.</p>
      </div>
    </footer>
  </body>
</html>
